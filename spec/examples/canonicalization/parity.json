{
  "description": "RFC 8785 canonicalisation cases shared by the Python and TypeScript SDKs and the auth service, in addition to the RFC 8785 test vectors in rfc8785/. Parse 'input' with the platform JSON parser, canonicalise the value and compare with 'canonical' (UTF-8). 'invalid' inputs must be refused.",
  "valid": [
    {
      "name": "member order, whitespace and number spelling",
      "input": "{ \"b\" : 2, \"a\" : [1, 2.0, 3e0, 1E3],\n \"c\": {\"z\": true, \"y\": null} }",
      "canonical": "{\"a\":[1,2,3,1000],\"b\":2,\"c\":{\"y\":null,\"z\":true}}"
    },
    {
      "name": "numbers in ECMAScript form",
      "input": "[1e21, 1e20, 0.000001, 1e-7, -0, -0.0, 5e-324, 1.7976931348623157e308, 9007199254740991, -9007199254740991, 0.1, 123.456e2, 1E-6, 100, 4.50, 2e-3]",
      "canonical": "[1e+21,100000000000000000000,0.000001,1e-7,0,0,5e-324,1.7976931348623157e+308,9007199254740991,-9007199254740991,0.1,12345.6,0.000001,100,4.5,0.002]"
    },
    {
      "name": "names sorted by UTF-16 code units, not code points",
      "input": "{\"\\ufb33\": 1, \"\\ud83d\\ude00\": 2, \"\\u00e9\": 3, \"e\": 4, \"E\": 5, \"\": 6}",
      "canonical": "{\"\":6,\"E\":5,\"e\":4,\"\u00e9\":3,\"\ud83d\ude00\":2,\"\ufb33\":1}"
    },
    {
      "name": "string escapes",
      "input": "\"\\u0000\\u001f\\u007f\\u2028\\\" \\\\ \\/ \\b\\f\\n\\r\\t\\u00e9\"",
      "canonical": "\"\\u0000\\u001f\u007f\u2028\\\" \\\\ / \\b\\f\\n\\r\\t\u00e9\""
    },
    {
      "name": "empty containers and literals",
      "input": "{\"a\": {}, \"b\": [], \"c\": \"\", \"d\": false, \"e\": null}",
      "canonical": "{\"a\":{},\"b\":[],\"c\":\"\",\"d\":false,\"e\":null}"
    },
    {
      "name": "nested arrays keep order",
      "input": "[[3, 2, 1], {\"b\": [2, 1], \"a\": [1, 2]}]",
      "canonical": "[[3,2,1],{\"a\":[1,2],\"b\":[2,1]}]"
    }
  ],
  "invalid": [
    {
      "name": "unpaired high surrogate in a string",
      "input": "\"\\ud800\""
    },
    {
      "name": "unpaired low surrogate in a member name",
      "input": "{\"\\udc00\": 1}"
    },
    {
      "name": "number overflowing a double",
      "input": "1e400"
    },
    {
      "name": "negative number overflowing a double",
      "input": "[-1e400]"
    }
  ]
}
