        "field_path": "anchor.audit_entry.hash",
        "expected": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "actual": "538b08d70d6c8d88cef16a4418d982b2b8b760bd72373ad8ba7edc6c43496c27"
      }
    },
    {
