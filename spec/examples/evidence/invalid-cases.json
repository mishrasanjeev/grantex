      "package": "package-signed.json",
      "options": {
        "jwks": "jwks.json"
      },
      "mutations": [
        {
          "op": "raw_replace",
          "find": "..",
          "replace": "..A"
        }
      ],
      "expect": {
        "code": "signature_invalid",
        "entry_index": null,
        "field_path": "signature.jws",
        "expected": null,
        "actual": null
      }
    }
  ]
}
