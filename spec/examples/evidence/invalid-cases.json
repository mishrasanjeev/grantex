      "mutations": [
        {
          "op": "set",
          "path": [
            "entries",
            4,
            "data",
            "call_id"
          ],
          "value": "call_0001"
        },
        {
          "op": "rehash_chain"
        }
      ],
      "expect": {
        "code": "duplicate_identifier",
        "entry_index": 4,
        "field_path": "entries[4].data.call_id",
        "expected": null,
        "actual": null
      }
    },
    {
      "name": "anchor audit entry edited",
      "package": "package.json",
      "mutations": [
        {
          "op": "set",
          "path": [
