FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
WORKDIR /work/packages/sdk-ts
COPY packages/sdk-ts/ ./
RUN npm ci && npm run build
WORKDIR /work/packages/mcp-auth
COPY packages/mcp-auth/ ./
COPY docs/mcp-auth.md /work/docs/mcp-auth.md
COPY spec/examples/grant-token-0.6.issued.json /work/spec/examples/grant-token-0.6.issued.json
RUN npm ci && npm run build
ENV CI=true
CMD ["sh", "-c", "npm run typecheck && npm test && npm run test:integration && npm run test:e2e"]
