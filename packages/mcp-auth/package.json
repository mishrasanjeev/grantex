{
  "name": "@grantex/mcp-auth",
  "version": "2.0.2",
  "description": "OAuth 2.1 + PKCE authorization server for MCP servers, powered by Grantex",
  "author": {
    "name": "Sanjeev Kumar",
    "email": "sanjeev@orchestrum.in"
  },
  "copyright": "Copyright 2026 Orchestrum Technologies LLP. Grantex inventor and owner: Sanjeev Kumar.",
  "homepage": "https://grantex.dev/for/mcp",
  "bugs": {
    "url": "https://github.com/mishrasanjeev/grantex/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./postgres": {
      "import": "./dist/postgres.js",
      "types": "./dist/postgres.d.ts"
    },
    "./redis": {
      "import": "./dist/redis.js",
      "types": "./dist/redis.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    },
    "./express": {
      "import": "./dist/middleware/express.js",
      "types": "./dist/middleware/express.d.ts"
    },
    "./hono": {
      "import": "./dist/middleware/hono.js",
      "types": "./dist/middleware/hono.d.ts"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && vitest run -c vitest.integration.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.0.0",
    "@grantex/sdk": ">=0.1.8",
    "fastify": "^5.2.1",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "selfsigned": "^5.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "grantex",
    "mcp",
    "oauth",
    "pkce",
    "authorization-server",
    "model-context-protocol",
    "ai-agents",
    "oauth2.1",
    "claude",
    "cursor"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mishrasanjeev/grantex"
  }
}
