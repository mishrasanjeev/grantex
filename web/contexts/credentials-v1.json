{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "id": "@id",
    "type": "@type",
    "grantex": "https://grantex.dev/vocab#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "AgentGrantCredential": "grantex:AgentGrantCredential",
    "AIAgent": "grantex:AIAgent",
    "principalId": "grantex:principalId",
    "developerId": "grantex:developerId",
    "grantId": "grantex:grantId",
    "scopes": {
      "@id": "grantex:scopes",
      "@container": "@set"
    },
    "delegationDepth": {
      "@id": "grantex:delegationDepth",
      "@type": "xsd:integer"
    },
    "GrantexWebAuthnAssertion": "grantex:GrantexWebAuthnAssertion",
    "version": { "@id": "grantex:version", "@type": "xsd:integer" },
    "authRequestId": "grantex:authRequestId",
    "credentialId": "grantex:credentialId",
    "credentialPublicKey": "grantex:credentialPublicKey",
    "previousCounter": { "@id": "grantex:previousCounter", "@type": "xsd:integer" },
    "rpId": "grantex:rpId",
    "origin": "grantex:origin",
    "challenge": "grantex:challenge",
    "clientDataJSON": "grantex:clientDataJSON",
    "authenticatorData": "grantex:authenticatorData",
    "signature": "grantex:signature",
    "userVerified": { "@id": "grantex:userVerified", "@type": "xsd:boolean" },
    "assertedAt": { "@id": "grantex:assertedAt", "@type": "xsd:dateTime" },
    "digest": "grantex:digest"
  }
}
