# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://grantex:grantex@localhost:5432/grantex
# Max PostgreSQL connections per service instance (default 3). Budget for all replicas.
# DATABASE_POOL_MAX=3
REDIS_URL=redis://localhost:6379
JWT_ISSUER=https://grantex.dev

# Signing algorithm for grant tokens and other platform JWTs: RS256 (default) or ES256
# JWT_SIGNING_ALG=RS256
# RSA key (PKCS#8 PEM) for RS256 — REQUIRED in production when JWT_SIGNING_ALG=RS256
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# EC P-256 key for ES256, in the same one-line PKCS#8 PEM form as above — REQUIRED in
# production when JWT_SIGNING_ALG=ES256. When the other algorithm signs, a configured key
# is published for verification only.
# EC_PRIVATE_KEY="<one-line PKCS#8 PEM of a P-256 key>"
# Public JWK Set of keys published for verification only (a key about to sign, or one that
# no longer signs): {"keys":[{"kid":"grantex-rs256-...","alg":"RS256",...}]}
# JWT_VERIFICATION_PUBLIC_KEYS=
# Thumbprint kid of the RSA key that signed pre-0.6 tokens (kid grantex-YYYY-MM); default: RSA_PRIVATE_KEY
# JWT_LEGACY_KID_KEY=
# Months of grantex-YYYY-MM kid aliases published for that key
# JWT_LEGACY_KID_MONTHS=13
# env (keys above) or postgres (stored encrypted with VAULT_ENCRYPTION_KEY; imports the keys above)
# SIGNING_KEY_STORE=env
# SIGNING_KEY_ACTIVATION_DELAY_SECONDS=900
# SIGNING_KEY_RETIRED_GRACE_SECONDS=2592000
# Longest grant lifetime accepted; the retired-key grace must cover it
# MAX_GRANT_LIFETIME_SECONDS=
# Default overlap of an agent key rotation, in seconds (7 days; at most 30 days)
# AGENT_KEY_ROTATION_OVERLAP_SECONDS=604800
# Mirror the key POST and PATCH /v1/agents write into the agent key history,
# with the history's refusals (default off; only exactly true turns it on)
# AGENT_KEY_HISTORY_MIRROR_ENABLED=false
# Legacy grant token claim aliases (agt, dev, grnt, scp, parentAgt, parentGrnt,
# delegationDepth, bdg) next to the standard claims. true by default in 0.6; false in 0.7.
# GRANT_TOKEN_LEGACY_CLAIMS=true
# For development only — auto-generates ephemeral key on startup:
AUTO_GENERATE_KEYS=true

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Flush an SSE readiness comment after subscribing, before the first event.
# Default off; enable to avoid an idle dashboard waiting for the 30-second heartbeat.
# EVENT_STREAM_READY_ENABLED=true

# Disabled by default. Enable only when every request reaches the service
# through a known proxy chain. Use a fixed hop count (1-16) or a
# comma-separated IP/CIDR allowlist; never trust every address.
# TRUST_PROXY=1

# ─── Admin ───────────────────────────────────────────────────────────────────
# ADMIN_API_KEY=your-strong-admin-key

# ─── Seed (development only) ────────────────────────────────────────────────
SEED_API_KEY=dev-api-key-local
# SEED_SANDBOX_KEY=dev-sandbox-key-local

# ─── Stripe Billing ─────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# ─── Credential Vault ───────────────────────────────────────────────────────
# AES encryption key: 64 hex chars OR 44 base64 chars
# VAULT_ENCRYPTION_KEY=0123456789abcdef...

# ─── FIDO2 / WebAuthn ───────────────────────────────────────────────────────
FIDO_RP_ID=localhost
FIDO_RP_NAME=Grantex Dev
FIDO_ORIGIN=http://localhost:3001
# Hosted customer enrollment, one-use tickets; enable only after HTTPS/RP testing.
PASSKEY_ENROLLMENT_ENABLED=false
# Account-wide alert-only or revoke response for legacy detector.
IRREGULARITY_RESPONSE_POLICY_ENABLED=false
# Cascade irregularity revocation through descendant grants, VCs and status lists.
IRREGULARITY_CASCADE_REVOCATION_ENABLED=false
PORTABLE_WEBAUTHN_EVIDENCE_STATUS_CHECK_ENABLED=false
# Requires cascade revocation; capture assertion evidence on new consent requests.
PORTABLE_WEBAUTHN_EVIDENCE_ENABLED=false

# ─── Registry ───────────────────────────────────────────────────────────────
# Unauthenticated registry reads: the attestation-acceptance status lists under
# /status/attestations, the issuer list, the minimised agent lookup and
# /.well-known/agent-registry.json; on only for exactly true.
REGISTRY_PUBLIC_ENDPOINTS_ENABLED=false

# ─── DID / Verifiable Credentials ───────────────────────────────────────────
DID_WEB_DOMAIN=grantex.dev
# ED25519_PRIVATE_KEY=... (optional — auto-generates if not set). Set it in
# production: DPDP consent proofs and Ed25519 credentials are verified against
# the published JWKS, and a per-process key does not survive a restart or
# match another instance. Unset with NODE_ENV=production logs a warning.

# ─── DPDP ────────────────────────────────────────────────────────────────────
# Each is off unless exactly true.
# A withdrawal that omits revokeGrant revokes the grant (DPDP Act s.6(6)).
# DPDP_WITHDRAWAL_REVOKES_GRANT=false
# Refuse a consent record whose dataPrincipalId is not the grant's principal.
# DPDP_ENFORCE_GRANT_PRINCIPAL=false
# Mark active consent records past processingExpiresAt expired (worker).
# DPDP_CONSENT_EXPIRY_ENABLED=false
# With the worker on, also revoke an expired record's grant.
# DPDP_CONSENT_EXPIRY_REVOKES_GRANT=false
# Refuse a consent notice missing a DPDP Rules 2025 r.3 element or not in
# English or an Eighth Schedule language (400 NOTICE_INCOMPLETE).
# DPDP_NOTICE_REQUIRE_RULE3=false
# Refuse a consent record without consentNoticeLanguage when the notice version
# exists in several languages (400 NOTICE_LANGUAGE_REQUIRED). Off, the newest
# notice row of the version is bound and its language recorded.
# DPDP_REQUIRE_NOTICE_LANGUAGE=false
# Refuse a gdpr-article-15 export without dataPrincipalId (400).
# DPDP_EXPORT_GDPR_REQUIRES_PRINCIPAL=false
# Emit dpdp.breach.board_report_due before and after a breach's 72-hour Board
# deadline (worker), and how many minutes before it (1-4320, default 720).
# DPDP_BREACH_DEADLINE_ALERTS_ENABLED=false
# DPDP_BREACH_ALERT_LEAD_MINUTES=720
# Refuse consent records (503) while the Ed25519 key is generated in-process
# (ED25519_PRIVATE_KEY unset): such proofs do not verify after a restart.
# DPDP_REQUIRE_PERSISTENT_PROOF_KEY=false
# DPDP revocations (withdrawal, erasure, expiry) also revoke delegated grants,
# their credentials and wallet reservations. Off: the record's grant only.
# DPDP_REVOCATION_CASCADE=false
# Erasure also redacts the principal's grievances and deletes stored exports.
# DPDP_ERASURE_EXPANDED=false

# ─── SSO ─────────────────────────────────────────────────────────────────────
# SSO_STATE_SECRET=... (optional — derived from RSA key if not set)

# ─── Policy Backends ────────────────────────────────────────────────────────
# OPA_URL=http://localhost:8181/v1/data/grantex
# OPA_FALLBACK_TO_BUILTIN=true
# CEDAR_URL=http://localhost:8182
# CEDAR_FALLBACK_TO_BUILTIN=true

# ─── Email ───────────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM=sanjeev@orchestrum.in

# ─── Observability ───────────────────────────────────────────────────────────
METRICS_ENABLED=true
USAGE_METERING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=grantex-auth-service

# --- Evidence packages (PRD G-5) ---------------------------------------------
# Off by default. The secret derives per-tenant pseudonymisation keys (exports need it); keep it in
# a secret manager and change EVIDENCE_PSEUDONYMISATION_KEY_ID when rotating it.
# EVIDENCE_EXPORT_ENABLED=false
# EVIDENCE_EXPORT_DEVELOPER_IDS=dev_id_1,dev_id_2
# EVIDENCE_DISCLOSURE_DEVELOPER_IDS=
# EVIDENCE_PSEUDONYMISATION_SECRET=<at least 32 random characters>
# EVIDENCE_PSEUDONYMISATION_KEY_ID=v1

# Optional Base USDC custody; disabled unless both settings are provisioned.
# Production RPC must use HTTPS and support finalized blocks and historical logs.
# Keep keys in a secret manager, never in source or an agent environment.
# BASE_USDC_RPC_URL=https://your-approved-base-rpc.example
# BASE_USDC_WALLETS={"wallet-id":{"privateKey":"0x<secret>","developerId":"dev_id","principalId":"principal_id"}}
# Requires migration 094 and stable VAULT_ENCRYPTION_KEY/RSA_PRIVATE_KEY.
# See docs/guides/base-usdc-custody.mdx for funding, recovery and custody risks.

# ─── Event bridge (provider events → grant actions) ─────────────────────────
# Off by default. Webhook sources store their secret with VAULT_ENCRYPTION_KEY.
# EVENT_BRIDGE_ENABLED=true
# EVENT_BRIDGE_DEVELOPER_IDS=dev_id_1,dev_id_2
# EVENT_BRIDGE_RATE_LIMIT_PER_MINUTE=30000
# Floor only: a receipt is never removed while its source would still accept
# the delivery it records (2x tolerance_seconds, or max_age_seconds + 2x the
# 60s clock skew), because that would make the delivery replayable.
# EVENT_BRIDGE_RECEIPT_RETENTION_HOURS=48

# ─── Decision grants (PRD G-3) ───────────────────────────────────────────────
# Off by default. Approvers sign in on this service's approval page with an
# identity provider the service administrator allow-lists per developer
# (POST /v1/admin/developers/:id/decision-approver-idps, ADMIN_API_KEY), and
# must show step-up: an `acr` in DECISION_STEP_UP_ACR or an `amr` in
# DECISION_STEP_UP_AMR, with auth_time no older than
# DECISION_STEP_UP_MAX_AGE_SECONDS. PUBLIC_BASE_URL must be https (the session
# cookie is __Host- and Secure) and VAULT_ENCRYPTION_KEY must be set. Invalid
# values make the decision endpoints answer 503 rather than fall back.
# DECISION_GRANTS_ENABLED=false
# Binds decision grants to the agent a request names: GET
# /v1/decisions/requests/:id stops returning the grants, they are released only
# to that agent's grant token and consumed only with it (grantToken). Off by default; only
# true or false are accepted. See docs/concepts/decision-grants.md for what a
# platform must change before turning it on.
# DECISION_GRANT_AGENT_BINDING=false
# DECISION_STEP_UP_AMR=mfa,hwk
# DECISION_STEP_UP_ACR=
# DECISION_STEP_UP_MAX_AGE_SECONDS=3600
# DECISION_ID_TOKEN_MAX_AGE_SECONDS=600
# DECISION_MIN_DWELL_MS=2000
# DECISION_MAX_DWELL_MS=86400000
# DECISION_LOGIN_STATE_SECONDS=600
# HMAC key for approval-page CSRF tokens; derived from VAULT_ENCRYPTION_KEY if unset.
# DECISION_PAGE_SECRET=<random 32+ bytes>

# ─── Migrations ──────────────────────────────────────────────────────────────
# Each migration file is applied once per database and recorded in
# schema_migrations. While applying, statements wait this long for a lock
# before the boot fails loudly rather than stalling a table behind them.
# MIGRATION_LOCK_TIMEOUT=2s
# ─── Revocation feed (how SDKs learn a grant stopped) ───────────────────────
# On by default. The SDKs check revocation online by default (and clients
# using revocationCheck="feed" follow the feed); both fail closed when these
# endpoints are not served. REVOCATION_FEED_ENABLED=false is the opt-out: only
# set it when every client is configured with revocationCheck="offline".
# REVOCATION_FEED_DEVELOPER_IDS limits the endpoints to these developers;
# every other developer's default SDK clients then deny every call.
# REVOCATION_FEED_ENABLED=false
# REVOCATION_FEED_DEVELOPER_IDS=dev_id_1,dev_id_2
# REVOCATION_FEED_POLL_MS=500
# REVOCATION_FEED_SETTLE_SECONDS=15
# REVOCATION_FEED_HEARTBEAT_MS=1000
# REVOCATION_FEED_MAX_CONNECTIONS=200
# REVOCATION_FEED_RETENTION_HOURS=48
# Each instance prunes the feed table first after a random delay of up to this
# many seconds (0 to 3600; 0 prunes at start), then hourly. Only one instance
# prunes at a time, in bounded batches.
# REVOCATION_FEED_PRUNE_JITTER_SECONDS=300

# ─── Emergency stop (halt every agent under a grant/agent/principal/tenant) ──
# Off by default. Revocations it makes are irreversible; see section 11 of
# docs/self-hosting.md for the runbook. A stop with `lockout: true` also freezes
# issuance under its scope until the freeze is lifted; issuance paths read
# lockouts only while this is on, so lift them before turning it off.
# EMERGENCY_STOP_ENABLED=true

# ─── Registry operator (accredited issuers) ─────────────────────────────────
# Keys for POST and PATCH /v1/registry/issuers, which accredit, suspend and
# withdraw issuers and revoke their keys. Comma separated, so a key can be
# rotated; each at least 32 characters. Separate from ADMIN_API_KEY. Unset,
# those routes answer 503; the public GET /v1/registry/issuers does not use them.
# REGISTRY_OPERATOR_API_KEYS=replace-with-a-long-random-operator-key
#
# The registry's unauthenticated reads (GET /v1/registry/issuers, paged with
# page and pageSize; the minimised agent lookup GET /v1/registry/agents/...
# without an API key; the signed manifest /.well-known/agent-registry.json).
# Off by default; on only for exactly true. Off, those routes are not
# registered and answer as any unknown route does; the agent lookup still
# answers a request with a developer API key.
# REGISTRY_PUBLIC_ENDPOINTS_ENABLED=true

# ─── Rate-limit buckets for containment and the revocation feed ─────────────
# On by default: revoking and the emergency stop use a containment bucket, and
# the revocation feed a status bucket, instead of the plan's. false puts them
# back in the plan bucket, failing closed when Redis is unavailable.
# RATE_LIMIT_ROUTE_CLASSES_ENABLED=false

# ─── Trust registry listing ──────────────────────────────────────────────────
# GET /v1/trust-registry lists every developer's records. Off by default, which
# keeps the existing behaviour: any developer API key can read it. true makes it
# take ADMIN_API_KEY instead (503 while that is unset); operators should turn
# it on. Only the exact value true enables it. Read at startup.
# TRUST_REGISTRY_ADMIN_LISTING_ENFORCED=true
