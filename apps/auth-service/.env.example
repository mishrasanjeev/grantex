# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://grantex:grantex@localhost:5432/grantex
REDIS_URL=redis://localhost:6379
JWT_ISSUER=https://grantex.dev

# Signing algorithm for grant tokens and other platform JWTs: RS256 (default) or ES256
# JWT_SIGNING_ALG=RS256
# RSA key (PKCS#8 PEM) for RS256 — REQUIRED in production when JWT_SIGNING_ALG=RS256
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# EC P-256 key for ES256, in the same one-line PKCS#8 PEM form as above — REQUIRED in
# production when JWT_SIGNING_ALG=ES256. When the other algorithm signs, a configured key
# is published for verification only.
# EC_PRIVATE_KEY="<one-line PKCS#8 PEM of a P-256 key>"
# Public JWK Set of keys published for verification only (a key about to sign, or one that
# no longer signs): {"keys":[{"kid":"grantex-rs256-...","alg":"RS256",...}]}
# JWT_VERIFICATION_PUBLIC_KEYS=
# Thumbprint kid of the RSA key that signed pre-0.6 tokens (kid grantex-YYYY-MM); default: RSA_PRIVATE_KEY
# JWT_LEGACY_KID_KEY=
# Months of grantex-YYYY-MM kid aliases published for that key
# JWT_LEGACY_KID_MONTHS=13
# env (keys above) or postgres (stored encrypted with VAULT_ENCRYPTION_KEY; imports the keys above)
# SIGNING_KEY_STORE=env
# SIGNING_KEY_ACTIVATION_DELAY_SECONDS=900
# SIGNING_KEY_RETIRED_GRACE_SECONDS=2592000
# Longest grant lifetime accepted; the retired-key grace must cover it
# MAX_GRANT_LIFETIME_SECONDS=
# Legacy grant token claim aliases (agt, dev, grnt, scp, parentAgt, parentGrnt,
# delegationDepth, bdg) next to the standard claims. true by default in 0.6; false in 0.7.
# GRANT_TOKEN_LEGACY_CLAIMS=true
# For development only — auto-generates ephemeral key on startup:
AUTO_GENERATE_KEYS=true

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Disabled by default. Enable only when every request reaches the service
# through a known proxy chain. Use a fixed hop count (1-16) or a
# comma-separated IP/CIDR allowlist; never trust every address.
# TRUST_PROXY=1

# ─── Admin ───────────────────────────────────────────────────────────────────
# ADMIN_API_KEY=your-strong-admin-key

# ─── Seed (development only) ────────────────────────────────────────────────
SEED_API_KEY=dev-api-key-local
# SEED_SANDBOX_KEY=dev-sandbox-key-local

# ─── Stripe Billing ─────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# ─── Credential Vault ───────────────────────────────────────────────────────
# AES encryption key: 64 hex chars OR 44 base64 chars
# VAULT_ENCRYPTION_KEY=0123456789abcdef...

# ─── FIDO2 / WebAuthn ───────────────────────────────────────────────────────
FIDO_RP_ID=localhost
FIDO_RP_NAME=Grantex Dev
FIDO_ORIGIN=http://localhost:3001

# ─── DID / Verifiable Credentials ───────────────────────────────────────────
DID_WEB_DOMAIN=grantex.dev
# ED25519_PRIVATE_KEY=... (optional — auto-generates if not set)

# ─── SSO ─────────────────────────────────────────────────────────────────────
# SSO_STATE_SECRET=... (optional — derived from RSA key if not set)

# ─── Policy Backends ────────────────────────────────────────────────────────
# OPA_URL=http://localhost:8181/v1/data/grantex
# OPA_FALLBACK_TO_BUILTIN=true
# CEDAR_URL=http://localhost:8182
# CEDAR_FALLBACK_TO_BUILTIN=true

# ─── Email ───────────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM=sanjeev@orchestrum.in

# ─── Observability ───────────────────────────────────────────────────────────
METRICS_ENABLED=true
USAGE_METERING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=grantex-auth-service

# --- Evidence packages (PRD G-5) ---------------------------------------------
# Off by default. The secret derives per-tenant pseudonymisation keys (exports need it); keep it in
# a secret manager and change EVIDENCE_PSEUDONYMISATION_KEY_ID when rotating it.
# EVIDENCE_EXPORT_ENABLED=false
# EVIDENCE_EXPORT_DEVELOPER_IDS=dev_id_1,dev_id_2
# EVIDENCE_DISCLOSURE_DEVELOPER_IDS=
# EVIDENCE_PSEUDONYMISATION_SECRET=<at least 32 random characters>
# EVIDENCE_PSEUDONYMISATION_KEY_ID=v1

# Optional Base USDC custody; disabled unless both settings are provisioned.
# Production RPC must use HTTPS and support finalized blocks and historical logs.
# Keep keys in a secret manager, never in source or an agent environment.
# BASE_USDC_RPC_URL=https://your-approved-base-rpc.example
# BASE_USDC_WALLETS={"wallet-id":{"privateKey":"0x<secret>","developerId":"dev_id","principalId":"principal_id"}}
# Requires migration 094 and stable VAULT_ENCRYPTION_KEY/RSA_PRIVATE_KEY.
# See docs/guides/base-usdc-custody.mdx for funding, recovery and custody risks.

# ─── Event bridge (provider events → grant actions) ─────────────────────────
# Off by default. Webhook sources store their secret with VAULT_ENCRYPTION_KEY.
# EVENT_BRIDGE_ENABLED=true
# EVENT_BRIDGE_DEVELOPER_IDS=dev_id_1,dev_id_2
# EVENT_BRIDGE_RATE_LIMIT_PER_MINUTE=30000
# Floor only: a receipt is never removed while its source would still accept
# the delivery it records (2x tolerance_seconds, or max_age_seconds + 2x the
# 60s clock skew), because that would make the delivery replayable.
# EVENT_BRIDGE_RECEIPT_RETENTION_HOURS=48

# ─── Decision grants (PRD G-3) ───────────────────────────────────────────────
# Off by default. Approvers sign in on this service's approval page with an
# identity provider the service administrator allow-lists per developer
# (POST /v1/admin/developers/:id/decision-approver-idps, ADMIN_API_KEY), and
# must show step-up: an `acr` in DECISION_STEP_UP_ACR or an `amr` in
# DECISION_STEP_UP_AMR, with auth_time no older than
# DECISION_STEP_UP_MAX_AGE_SECONDS. PUBLIC_BASE_URL must be https (the session
# cookie is __Host- and Secure) and VAULT_ENCRYPTION_KEY must be set. Invalid
# values make the decision endpoints answer 503 rather than fall back.
# DECISION_GRANTS_ENABLED=false
# DECISION_STEP_UP_AMR=mfa,hwk
# DECISION_STEP_UP_ACR=
# DECISION_STEP_UP_MAX_AGE_SECONDS=3600
# DECISION_ID_TOKEN_MAX_AGE_SECONDS=600
# DECISION_MIN_DWELL_MS=2000
# DECISION_MAX_DWELL_MS=86400000
# DECISION_LOGIN_STATE_SECONDS=600
# HMAC key for approval-page CSRF tokens; derived from VAULT_ENCRYPTION_KEY if unset.
# DECISION_PAGE_SECRET=<random 32+ bytes>

# ─── Revocation feed (how SDKs learn a grant stopped) ───────────────────────
# Off by default. Clients using revocationCheck="feed" fail closed when the
# feed is not served, so turn it on before switching agents to feed mode.
# REVOCATION_FEED_ENABLED=true
# REVOCATION_FEED_DEVELOPER_IDS=dev_id_1,dev_id_2
# REVOCATION_FEED_POLL_MS=500
# REVOCATION_FEED_SETTLE_SECONDS=15
# REVOCATION_FEED_HEARTBEAT_MS=1000
# REVOCATION_FEED_MAX_CONNECTIONS=200
# REVOCATION_FEED_RETENTION_HOURS=48

# ─── Emergency stop (halt every agent under a grant/agent/principal/tenant) ──
# Off by default. Revocations it makes are irreversible; see section 11 of
# docs/self-hosting.md for the runbook.
# EMERGENCY_STOP_ENABLED=true
