{
  "name": "@grantex/auth-service",
  "version": "0.1.0",
  "description": "Grantex auth service \u2014 issues RS256 grant tokens",
  "author": {
    "name": "Sanjeev Kumar",
    "email": "sanjeev@orchestrum.in"
  },
  "copyright": "Copyright 2026 Orchestrum Technologies LLP. Grantex inventor and owner: Sanjeev Kumar.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch dist/index.js",
    "build": "tsc -p tsconfig.build.json && node -e \"const{cpSync}=require('fs');cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:production": "vitest run -c vitest.production.config.ts",
    "probe:migrations": "node --experimental-transform-types scripts/migration-contention-probe.mjs"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "brace-expansion": "^5.0.8"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.3",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@simplewebauthn/server": "^14.0.3",
    "@x402/evm": "2.28.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "stripe": "^22.6.2",
    "ulid": "^3.0.2",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0"
}
