{
  "name": "@grantex/auth-service",
  "version": "0.1.0",
  "description": "Grantex auth service — issues RS256 grant tokens",
  "author": {
    "name": "Sanjeev Kumar",
    "email": "sanjeev@orchestrum.in"
  },
  "copyright": "Copyright 2026 Orchestrum Technologies LLP. Grantex inventor and owner: Sanjeev Kumar.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch dist/index.js",
    "build": "tsc -p tsconfig.build.json && node -e \"const{cpSync}=require('fs');cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "brace-expansion": "^5.0.8"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@simplewebauthn/server": "^13.3.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "stripe": "^22.6.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "pino-pretty": "^13.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0"
}
