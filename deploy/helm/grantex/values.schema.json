{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowClusterDns", "ingressNamespaces", "allowedEgress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowClusterDns": { "type": "boolean" },
        "ingressNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" }
        },
        "allowedEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cidr", "ports"],
            "properties": {
              "cidr": { "type": "string", "minLength": 4, "maxLength": 49, "pattern": "^[0-9A-Fa-f:.]+/[1-9][0-9]{0,2}$" },
              "ports": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["port"],
                  "properties": {
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                    "protocol": { "type": "string", "enum": ["TCP", "UDP", "SCTP"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
